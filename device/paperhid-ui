#!/bin/sh
# Single allow-listed PaperHid on-device control helper for Settings > Help.
# Invoked only with fixed command names and allow-listed arguments from QML.
# Usage: paperhid-ui <command> [arg]
set -eu

HOME_PH="/home/root/.paperhid"
HOME_PP="/home/root/.paperpointer"
CONF="$HOME_PP/pointer.conf"
LOCK_DIR="$HOME_PH/paperhid-ui.lock"
LOG="$HOME_PH/ui.log"
ERR_FILE="$HOME_PH/last-error"
KB_SERVICE="remarkable-bt-keyboard.service"
PTR_SERVICE="paperpointer.service"
KB_MAC_FILE="/home/root/.paperwriter-keyboard"

mkdir -p "$HOME_PH" 2>/dev/null || true

log() {
    ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown)
    echo "[$ts] $*" >>"$LOG" 2>/dev/null || true
}

set_error() {
    printf '%s\n' "$*" >"$ERR_FILE" 2>/dev/null || true
    log "ERROR: $*"
}

clear_error() {
    rm -f "$ERR_FILE" 2>/dev/null || true
}

json_escape() {
    # Minimal JSON string escape (no control chars expected in our fields).
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}

svc_state() {
    unit="$1"
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
        echo active
    elif systemctl is-failed --quiet "$unit" 2>/dev/null; then
        echo failed
    elif systemctl cat "$unit" >/dev/null 2>&1; then
        echo inactive
    else
        echo absent
    fi
}

get_conf() {
    key="$1"
    default="$2"
    if [ -f "$CONF" ] && grep -q "^${key}=" "$CONF" 2>/dev/null; then
        sed -n "s/^${key}=//p" "$CONF" | head -n 1
    else
        echo "$default"
    fi
}

set_conf() {
    key="$1"
    value="$2"
    if [ ! -f "$CONF" ]; then
        set_error "pointer.conf missing"
        return 10
    fi
    if grep -q "^${key}=" "$CONF"; then
        sed -i "s/^${key}=.*/${key}=${value}/" "$CONF"
    else
        echo "${key}=${value}" >>"$CONF"
    fi
}

restart_pointer() {
    if ! systemctl cat "$PTR_SERVICE" >/dev/null 2>&1; then
        set_error "pointer service not installed"
        return 11
    fi
    systemctl restart "$PTR_SERVICE" || {
        set_error "pointer restart failed"
        return 12
    }
    i=0
    while [ "$i" -lt 8 ]; do
        if systemctl is-active --quiet "$PTR_SERVICE"; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.25
    done
    systemctl is-active --quiet "$PTR_SERVICE" || {
        set_error "pointer service not active after restart"
        return 12
    }
}

# Bounded command runner (BusyBox may ship timeout applet).
run_bounded() {
    secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
        return $?
    fi
    # Fallback: run in background and kill on deadline (best-effort).
    "$@" &
    pid=$!
    i=0
    while [ "$i" -lt "$secs" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid"
            return $?
        fi
        i=$((i + 1))
        sleep 1
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    return 124
}

btctl() {
    # shellcheck disable=SC2086
    run_bounded 8 bluetoothctl "$@" 2>/dev/null || true
}

sysctl_quiet() {
    run_bounded 15 systemctl "$@" >/dev/null 2>&1
    return $?
}

with_lock() {
    # Reclaim lock only if owner PID is dead (not age-based — layout can be long).
    if [ -d "$LOCK_DIR" ]; then
        if [ -f "$LOCK_DIR/pid" ]; then
            old=$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)
            if [ -n "$old" ] && ! kill -0 "$old" 2>/dev/null; then
                rm -rf "$LOCK_DIR" 2>/dev/null || true
            fi
        else
            # Legacy lock without pid: drop if empty/orphan.
            rmdir "$LOCK_DIR" 2>/dev/null || true
        fi
    fi
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        # Contention: do not clobber last real error.
        printf '%s\n' '{"ok":false,"error":"busy"}'
        exit 3
    fi
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
    # shellcheck disable=SC2064
    trap 'rm -rf "$LOCK_DIR" 2>/dev/null || true' EXIT INT HUP TERM
    "$@"
    code=$?
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    trap - EXIT INT HUP TERM
    return "$code"
}

# Parse adapter flags from one bluetoothctl show blob.
parse_show_flag() {
    field="$1"
    blob="$2"
    echo "$blob" | sed -n "s/^[[:space:]]*${field}:[[:space:]]*//p" | head -n 1 | tr '[:upper:]' '[:lower:]'
}

emit_status_json() {
    # Args via globals set by cmd_status: adapter_*, services, paired_json, nodes_json, ...
    printf '%s\n' "{\"ok\":true,\"adapter\":{\"present\":${adapter_present},\"powered\":${powered},\"pairable\":${pairable},\"discovering\":${discovering}},\"services\":{\"bluetooth\":\"${bt_svc}\",\"keyboard\":\"${kb_svc}\",\"pointer\":\"${ptr_svc}\"},\"keyboard\":{\"saved_mac\":\"${saved_mac_j}\",\"layout\":\"${layout_j}\"},\"paired\":${paired_json},\"input_nodes\":${nodes_json},\"pointer\":{\"installed\":${pointer_installed},\"service\":\"${ptr_svc}\",\"cursor\":${cursor},\"cursor_hide_ms\":${hide},\"accel\":${accel},\"cursor_style\":\"$(json_escape "$style")\"},\"last_error\":\"${last_err_j}\"}"
}

cmd_status() {
    # Usage: cmd_status [ --fast ]
    # --fast: UI path — one show, paired list only, no per-device info.
    fast=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --fast) fast=1 ;;
            *)
                printf '%s\n' '{"ok":false,"error":"invalid status argument"}'
                return 2
                ;;
        esac
        shift
    done

    adapter_present=false
    powered=false
    pairable=false
    discovering=false

    show_blob=$(btctl show)
    list_blob=$(btctl list)
    if echo "$list_blob" | grep -q .; then
        adapter_present=true
    fi
    p=$(parse_show_flag Powered "$show_blob")
    [ "$p" = "yes" ] && powered=true
    p=$(parse_show_flag Pairable "$show_blob")
    [ "$p" = "yes" ] && pairable=true
    p=$(parse_show_flag Discovering "$show_blob")
    [ "$p" = "yes" ] && discovering=true

    bt_svc=$(svc_state bluetooth.service)
    kb_svc=$(svc_state "$KB_SERVICE")
    ptr_svc=$(svc_state "$PTR_SERVICE")

    saved_mac=""
    if [ -f "$KB_MAC_FILE" ]; then
        saved_mac=$(tr -d ' \t\r\n' <"$KB_MAC_FILE" | cut -c1-17)
    fi
    saved_mac_j=$(json_escape "$saved_mac")

    tmp_paired="$HOME_PH/.status-paired.$$"
    : >"$tmp_paired"
    paired_blob=$(btctl devices Paired)
    echo "$paired_blob" | while IFS= read -r line; do
        mac=$(echo "$line" | sed -n 's/^Device \([0-9A-Fa-f:]\{17\}\) .*/\1/p')
        [ -n "$mac" ] || continue
        name=$(echo "$line" | sed -n 's/^Device [0-9A-Fa-f:]\{17\} //p')
        trusted=false
        connected=false
        if [ "$fast" -eq 0 ]; then
            info=$(btctl info "$mac")
            echo "$info" | grep -qi 'Trusted: yes' && trusted=true
            echo "$info" | grep -qi 'Connected: yes' && connected=true
        fi
        mac_u=$(echo "$mac" | tr '[:lower:]' '[:upper:]')
        printf '%s\t%s\t%s\t%s\n' "$mac_u" "$name" "$trusted" "$connected" >>"$tmp_paired"
    done
    first=1
    paired_json="["
    while IFS=$(printf '\t') read -r mac name trusted connected; do
        [ -n "$mac" ] || continue
        name_j=$(json_escape "$name")
        if [ "$first" -eq 1 ]; then
            first=0
        else
            paired_json="${paired_json},"
        fi
        paired_json="${paired_json}{\"mac\":\"${mac}\",\"name\":\"${name_j}\",\"trusted\":${trusted},\"connected\":${connected}}"
    done <"$tmp_paired"
    paired_json="${paired_json}]"
    rm -f "$tmp_paired"

    nodes_json="[]"
    if [ "$fast" -eq 0 ]; then
        tmp_nodes="$HOME_PH/.status-nodes.$$"
        : >"$tmp_nodes"
        if [ -r /proc/bus/input/devices ]; then
            grep -E '^N: Name=' /proc/bus/input/devices 2>/dev/null \
                | sed 's/^N: Name="//; s/"$//' \
                | grep -Ei 'key|mouse|touchpad|track|clvx|hid' \
                | head -n 12 >"$tmp_nodes" || true
        fi
        nodes_json="["
        first=1
        while IFS= read -r n; do
            [ -n "$n" ] || continue
            nj=$(json_escape "$n")
            if [ "$first" -eq 1 ]; then
                first=0
            else
                nodes_json="${nodes_json},"
            fi
            nodes_json="${nodes_json}\"${nj}\""
        done <"$tmp_nodes"
        nodes_json="${nodes_json}]"
        rm -f "$tmp_nodes"
    fi

    hide=$(get_conf cursor_hide_ms 0)
    accel=$(get_conf accel 2.0)
    cursor=$(get_conf cursor 0)
    style=$(get_conf cursor_style cross)
    pointer_installed=false
    [ -f "$HOME_PP/paperpointerd.py" ] && pointer_installed=true

    layout_key=""
    if [ -f /home/root/.paperwriter-layout ]; then
        layout_key=$(tr -d ' \t\r\n' </home/root/.paperwriter-layout | cut -c1-16)
    fi
    layout_j=$(json_escape "$layout_key")

    last_err=""
    if [ -f "$ERR_FILE" ]; then
        last_err=$(sed -n '1p' "$ERR_FILE" 2>/dev/null || true)
    fi
    last_err_j=$(json_escape "$last_err")

    emit_status_json
}

# --- Bluetooth (reconnect service order matters) ---

cmd_bluetooth_on() {
    clear_error
    if ! sysctl_quiet start bluetooth; then
        # May already be active.
        true
    fi
    btctl power on >/dev/null
    btctl pairable on >/dev/null
    if systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        sysctl_quiet start "$KB_SERVICE" || true
    fi
    show_blob=$(btctl show)
    p=$(parse_show_flag Powered "$show_blob")
    if [ "$p" != "yes" ]; then
        set_error "bluetooth power on failed"
        printf '%s\n' '{"ok":false,"error":"bluetooth power on failed"}'
        return 13
    fi
    log "bluetooth-on"
    printf '%s\n' '{"ok":true,"action":"bluetooth-on"}'
}

cmd_bluetooth_off() {
    clear_error
    # Stop reconnect first so it cannot power the adapter back on.
    if systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        sysctl_quiet stop "$KB_SERVICE" || true
    fi
    # Best-effort disconnect (timeouts apply via btctl).
    btctl devices Connected | while IFS= read -r line; do
        mac=$(echo "$line" | sed -n 's/^Device \([0-9A-Fa-f:]\{17\}\).*/\1/p')
        [ -n "$mac" ] || continue
        btctl disconnect "$mac" >/dev/null
    done
    btctl power off >/dev/null
    log "bluetooth-off"
    printf '%s\n' '{"ok":true,"action":"bluetooth-off"}'
}

cmd_bluetooth_restart() {
    clear_error
    if systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        sysctl_quiet stop "$KB_SERVICE" || true
    fi
    if ! sysctl_quiet restart bluetooth; then
        set_error "bluetooth restart failed"
        printf '%s\n' '{"ok":false,"error":"bluetooth restart failed"}'
        return 13
    fi
    sleep 1
    btctl power on >/dev/null
    btctl pairable on >/dev/null
    if systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        sysctl_quiet start "$KB_SERVICE" || true
    fi
    show_blob=$(btctl show)
    p=$(parse_show_flag Powered "$show_blob")
    if [ "$p" != "yes" ]; then
        set_error "bluetooth restart: power on failed"
        printf '%s\n' '{"ok":false,"error":"bluetooth restart: power on failed"}'
        return 13
    fi
    log "bluetooth-restart"
    printf '%s\n' '{"ok":true,"action":"bluetooth-restart"}'
}

cmd_keyboard_enable() {
    clear_error
    if ! systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        set_error "keyboard service not installed"
        printf '%s\n' '{"ok":false,"error":"keyboard service not installed"}'
        return 14
    fi
    systemctl enable "$KB_SERVICE" 2>/dev/null || true
    systemctl start "$KB_SERVICE" || {
        set_error "keyboard enable failed"
        printf '%s\n' '{"ok":false,"error":"keyboard enable failed"}'
        return 14
    }
    log "keyboard-enable"
    printf '%s\n' '{"ok":true,"action":"keyboard-enable"}'
}

cmd_keyboard_disable() {
    clear_error
    if systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        systemctl stop "$KB_SERVICE" 2>/dev/null || true
        systemctl disable "$KB_SERVICE" 2>/dev/null || true
    fi
    log "keyboard-disable"
    printf '%s\n' '{"ok":true,"action":"keyboard-disable"}'
}

cmd_keyboard_reconnect() {
    clear_error
    if ! systemctl cat "$KB_SERVICE" >/dev/null 2>&1; then
        set_error "keyboard service not installed"
        printf '%s\n' '{"ok":false,"error":"keyboard service not installed"}'
        return 15
    fi
    # Nondestructive: restart reconnect path without removing pairings.
    systemctl restart "$KB_SERVICE" || {
        set_error "keyboard reconnect failed"
        printf '%s\n' '{"ok":false,"error":"keyboard reconnect failed"}'
        return 15
    }
    mac=""
    if [ -f "$KB_MAC_FILE" ]; then
        mac=$(tr -d ' \t\r\n' <"$KB_MAC_FILE" | cut -c1-17)
    fi
    case "$mac" in
        [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
            bluetoothctl connect "$mac" >/dev/null 2>&1 || true
            ;;
    esac
    log "keyboard-reconnect"
    printf '%s\n' '{"ok":true,"action":"keyboard-reconnect"}'
}

cmd_pointer_restart() {
    clear_error
    restart_pointer || {
        printf '%s\n' '{"ok":false,"error":"pointer restart failed"}'
        return 12
    }
    log "pointer-restart"
    printf '%s\n' '{"ok":true,"action":"pointer-restart"}'
}

cmd_set_accel() {
    val="${1:-}"
    case "$val" in
        1.0|2.0|3.0|4.0) ;;
        *)
            set_error "accel must be 1.0, 2.0, 3.0, or 4.0"
            printf '%s\n' '{"ok":false,"error":"invalid accel"}'
            return 2
            ;;
    esac
    clear_error
    set_conf accel "$val" || {
        printf '%s\n' '{"ok":false,"error":"pointer.conf missing"}'
        return 10
    }
    restart_pointer || {
        printf '%s\n' '{"ok":false,"error":"pointer restart failed"}'
        return 12
    }
    log "set-accel $val"
    printf '%s\n' "{\"ok\":true,\"action\":\"set-accel\",\"accel\":\"${val}\"}"
}

cmd_set_cursor_style() {
    val="${1:-}"
    case "$val" in
        cross|win95) ;;
        *)
            set_error "style must be cross or win95"
            printf '%s\n' '{"ok":false,"error":"invalid style"}'
            return 2
            ;;
    esac
    if [ "$val" = "win95" ] && [ ! -f "$HOME_PP/cursors/win95.png" ]; then
        set_error "missing win95.png"
        printf '%s\n' '{"ok":false,"error":"missing win95 skin"}'
        return 3
    fi
    clear_error
    set_conf cursor_style "$val" || {
        printf '%s\n' '{"ok":false,"error":"pointer.conf missing"}'
        return 10
    }
    printf '%s\n' "$val" >"$HOME_PP/cursor_style"
    restart_pointer || {
        printf '%s\n' '{"ok":false,"error":"pointer restart failed"}'
        return 12
    }
    log "set-cursor-style $val"
    printf '%s\n' "{\"ok\":true,\"action\":\"set-cursor-style\",\"style\":\"${val}\"}"
}

cmd_set_hide_ms() {
    val="${1:-}"
    case "$val" in
        0|3000|10000|60000) ;;
        *)
            set_error "hide_ms must be 0, 3000, 10000, or 60000"
            printf '%s\n' '{"ok":false,"error":"invalid hide_ms"}'
            return 2
            ;;
    esac
    clear_error
    set_conf cursor_hide_ms "$val" || {
        printf '%s\n' '{"ok":false,"error":"pointer.conf missing"}'
        return 10
    }
    restart_pointer || {
        printf '%s\n' '{"ok":false,"error":"pointer restart failed"}'
        return 12
    }
    log "set-hide-ms $val"
    printf '%s\n' "{\"ok\":true,\"action\":\"set-hide-ms\",\"hide_ms\":${val}}"
}

cmd_set_layout() {
    # Keyboard need not be connected — layout patches libepaper for when it is.
    # Always restart via XOVI (set_layout.py) so Settings → Help does not vanish.
    val="${1:-}"
    case "$val" in
        us|us_intl|uk|de|fr|fr_ca|es|it|pt|br|nl|sv|no|dk|fi|is|de_ch|fr_ch|be|ru|ua|cz|hu|tr|gr|he) ;;
        *)
            set_error "invalid layout"
            printf '%s\n' '{"ok":false,"error":"invalid layout"}'
            return 2
            ;;
    esac
    clear_error
    if [ ! -x /opt/bin/python3 ]; then
        set_error "tablet python required for layout"
        printf '%s\n' '{"ok":false,"error":"tablet python required for layout"}'
        return 16
    fi
    if [ ! -f "$HOME_PH/set_layout.py" ]; then
        set_error "set_layout.py missing"
        printf '%s\n' '{"ok":false,"error":"set_layout.py missing"}'
        return 16
    fi
    # Layout stops xochitl (UI dies mid-command); helper must restore XOVI.
    out=$(/opt/bin/python3 "$HOME_PH/set_layout.py" "$val" 2>"$HOME_PH/set-layout.err") || {
        err=$(sed -n '1p' "$HOME_PH/set-layout.err" 2>/dev/null || true)
        set_error "layout failed: ${err:-unknown}"
        # Last-ditch: bring UI back even if helper crashed hard.
        if [ -x /home/root/xovi/start ]; then
            systemctl reset-failed xochitl.service 2>/dev/null || true
            /home/root/xovi/start >/tmp/paperhid-layout-recover.log 2>&1 || \
                systemctl start xochitl 2>/dev/null || true
        else
            systemctl start xochitl 2>/dev/null || true
        fi
        if [ -n "$out" ]; then
            printf '%s\n' "$out"
        else
            printf '%s\n' '{"ok":false,"error":"layout failed"}'
        fi
        return 1
    }
    log "set-layout $val"
    printf '%s\n' "$out"
}

usage() {
    echo "Usage: paperhid-ui <command> [arg]" >&2
    echo "  status [--fast] | bluetooth-on | bluetooth-off | bluetooth-restart" >&2
    echo "  keyboard-enable | keyboard-disable | keyboard-reconnect" >&2
    echo "  pointer-restart | set-accel <v> | set-cursor-style <s> | set-hide-ms <ms>" >&2
    echo "  set-layout <key>" >&2
    exit 2
}

cmd="${1:-}"
[ -n "$cmd" ] || usage
shift || true

case "$cmd" in
    status)
        # Serialize with BT mutations (critical section backstop).
        with_lock cmd_status "$@"
        ;;
    bluetooth-on)
        with_lock cmd_bluetooth_on
        ;;
    bluetooth-off)
        with_lock cmd_bluetooth_off
        ;;
    bluetooth-restart)
        with_lock cmd_bluetooth_restart
        ;;
    keyboard-enable)
        with_lock cmd_keyboard_enable
        ;;
    keyboard-disable)
        with_lock cmd_keyboard_disable
        ;;
    keyboard-reconnect)
        with_lock cmd_keyboard_reconnect
        ;;
    pointer-restart)
        with_lock cmd_pointer_restart
        ;;
    set-accel)
        with_lock cmd_set_accel "${1:-}"
        ;;
    set-cursor-style)
        with_lock cmd_set_cursor_style "${1:-}"
        ;;
    set-hide-ms)
        with_lock cmd_set_hide_ms "${1:-}"
        ;;
    set-layout)
        with_lock cmd_set_layout "${1:-}"
        ;;
    *)
        usage
        ;;
esac
