[Unit]
Description=PaperHid BT unit re-seed from home (overlay recovery)
DefaultDependencies=no
After=local-fs.target
Before=remarkable-bt-keyboard.service multi-user.target

[Service]
Type=oneshot
ExecStart=/home/root/.paperwriter/paperwriter-bt-bootstrap.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
